{
  "appId": "me.vattitude.morningbrief",
  "appName": "Hark Daily",
  "webDir": "web",
  "server": {
    "url": "https://hark.vattitude.ca",
    "cleartext": false,
    "allowNavigation": [
      "hark.vattitude.ca",
      "*.supabase.co"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0d0d0d"
  },
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile",
    "scheme": "me.vattitude.morningbrief",
    "backgroundColor": "#0d0d0d"
  },
  "plugins": {
    "SystemBars": {
      "initialViewportFitValueHint": "cover"
    },
    "LocalNotifications": {
      "smallIcon": "ic_notification",
      "iconColor": "#F59E0B"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
