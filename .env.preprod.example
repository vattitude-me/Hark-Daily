# Hark Daily — Pre-Prod / Dev Environment Template
# Copy to `.env.preprod` (gitignored) and fill in your pre-prod Supabase secret key and AI keys.
#
# Usage (Mac / Linux):
#   ENV_FILE=.env.preprod ./.venv/bin/python -m app check
#   ENV_FILE=.env.preprod ./.venv/bin/python -m app pack --edition ca --voice her_reference
#   npx serve web -l 3000   # then open http://localhost:3000 (auto-targets pre-prod Supabase)

# Isolated Pre-Prod Supabase project (NEVER use your production key here)
SUPABASE_URL=https://hhcygubulddewtwkedkz.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_YOUR_PREPROD_SECRET_KEY
SUPABASE_BUCKET=briefings

# Isolated local cache/state directory so pre-prod never shares prod VAPID keys or batch locks
DATA_DIR=data_preprod

# Safety defaults for Dev / Pre-Prod
DAILY_BATCH=false
ADMIN_NOTIFY=issues
GCE_MANAGE_VM=false
VAPID_SUBJECT=https://preprod.hark.vattitude.ca

# Script generation: uses local Antigravity CLI (`agy`) by default — no LLM API keys needed
AGY_ENABLED=true
AGY_MODEL=gemini-4-hydrogen-low

# Two-host Podcast mode (Matthew & Kelly) & local Chatterbox voice service
# VOICE_SERVICE_URL=http://127.0.0.1:8090
PODCAST_ENABLED=true
PODCAST_HOSTS=matthew_reference,kelly_reference
STORY_VOICE=matthew_reference+kelly_reference
STORY_VOICES=matthew_reference+kelly_reference
